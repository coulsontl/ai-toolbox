{
    "version": "1.2.2",
    "description": "Desktop toolbox for managing AI coding assistant configurations",
    "homepage": "https://github.com/coulsontl/ai-toolbox",
    "license": "AGPL-3.0-or-later",
    "architecture": {
        "64bit": {
            "url": "https://github.com/coulsontl/ai-toolbox/releases/download/v1.2.2/AI.Toolbox_1.2.2_x64-setup.exe#/dl.exe",
            "hash": "sha256:4f810499d134f14a0b8a79fe6605682ae39d9bcf691f27c9aa7f6c2774dede9c"
        }
    },
    "installer": {
        "script": [
            "# Tauri NSIS installer (currentUser). /S = silent, /D = install dir.",
            "# /D must be the LAST switch and unquoted (NSIS requirement).",
            "Start-Process -Wait -FilePath \"$dir\\dl.exe\" -ArgumentList '/S', \"/D=$dir\"",
            "# Scoop only auto-removes the installer for installer.file/args, not for script hooks.",
            "Remove-Item \"$dir\\dl.exe\" -Force -ErrorAction SilentlyContinue"
        ]
    },
    "uninstaller": {
        "script": [
            "if (Test-Path \"$dir\\uninstall.exe\") { Start-Process -Wait -FilePath \"$dir\\uninstall.exe\" -ArgumentList '/S' }"
        ]
    },
    "shortcuts": [
        [
            "ai-toolbox.exe",
            "AI Toolbox"
        ]
    ]
}
