{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Toolbox",
  "version": "1.2.1",
  "identifier": "com.ai-toolbox",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": [
      "licenses/AGPL-3.0.txt",
      "licenses/GPL-3.0.txt",
      "licenses/LGPL-3.0.txt",
      "licenses/NOTICE"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "deep-link": {
      "desktop": {
        "schemes": ["aitoolbox"]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFENkM1QTI3OTA0MkE3M0YKUldRL3AwS1FKMXBzSGVCZUJqSWNvcXNLcExuRGhlQkovcXhyTEpOTU96K2JpQytGbkZQbDZHV20K",
      "endpoints": [
        "https://github.com/coulsontl/ai-toolbox/releases/latest/download/latest.json"
      ]
    }
  }
}
